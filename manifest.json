{
  "schemaVersion": 1,
  "id": "cucu0628.dashboard",
  "name": "Prism Dashboard",
  "version": "1.3.0",
  "author": "Sadra Alikhah; original dashboard by cucu0628",
  "license": "MIT",
  "description": "Artwork-driven music colors, liquid animations, audio spectrum, calendar, and local weather",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "Prism Dashboard",
    "description": "An animated music dashboard with calendar, weather, and provider-aware playback controls",
    "category": "Time",
    "allowMultiple": false,
    "defaultSection": "center",
    "defaults": {
      "format": "dddd HH:mm",
      "verticalFormat": "HH\n—\nmm",
      "weatherUnit": "celsius",
      "clockSpectrum": true,
      "dynamicCoverColors": true,
      "displayDots": true,
      "displayWaves": true
    },
    "schema": [
      {
        "key": "clockSpectrum",
        "type": "boolean",
        "label": "Audio spectrum behind clock",
        "defaultValue": true
      },
      {
        "key": "format",
        "type": "string",
        "label": "Clock format"
      },
      {
        "key": "verticalFormat",
        "type": "string",
        "label": "Vertical clock format"
      },
      {
        "key": "weatherUnit",
        "type": "enum",
        "label": "Weather temperature unit",
        "options": [
          "celsius",
          "fahrenheit"
        ],
        "defaultValue": "celsius"
      },
      {
        "key": "dynamicCoverColors",
        "label": "Dynamic music cover colors",
        "type": "boolean",
        "defaultValue": true
      },
      {
        "key": "displayDots",
        "label": "Display dots animation",
        "type": "boolean",
        "defaultValue": true
      },
      {
        "key": "displayWaves",
        "label": "Display waves animation",
        "type": "boolean",
        "defaultValue": true
      }
    ]
  }
}
